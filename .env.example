# Choose which PostgreSQL database this process connects to: local or render.
DB_TARGET=local

# Local PostgreSQL settings. Keep real credentials in your ignored .env.
POSTGRES_USER=your_local_db_user
POSTGRES_PASSWORD=your_local_db_password
POSTGRES_DB=your_local_db_name
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# For Render, set DB_TARGET=render and DATABASE_URL in the Render service's
# Environment settings. Prefer the internal database URL for the deployed app.
# Do not put production credentials in this template.
DATABASE_URL=

# Other project secrets (fill these in your private .env as needed).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
TAVILY_API_KEY=
AVIATION_STACK_API_KEY=
OPENWEATHER_API_KEY=
